msgstr "Αποθήκευση ρυθμίσεων ασφάλειας"

msgid "All environment checks passed."
msgstr "Όλοι οι έλεγχοι περιβάλλοντος ολοκληρώθηκαν επιτυχώς."

msgid "Administrators only"
msgstr "Μόνο διαχειριστές"

msgid "Administrators and SitePilot Operators"
msgstr "Διαχειριστές και χειριστές SitePilot"

