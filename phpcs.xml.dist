<?xml version="1.0"?>
<ruleset name="SitePilot MCP">
  <description>WordPress coding standards for production plugin sources.</description>
  <file>sitepilot-mcp.php</file><file>src</file><file>uninstall.php</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <rule ref="WordPress-Core">
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
  </rule>
  <rule ref="WordPress-Extra">
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
  </rule>
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="sitepilot_connect"/>
        <element value="sitepilot_manage_policy"/>
        <element value="sitepilot_approve"/>
        <element value="sitepilot_view_audit"/>
      </property>
    </properties>
  </rule>
  <config name="text_domain" value="sitepilot-mcp"/>
  <config name="minimum_supported_wp_version" value="6.9"/>
</ruleset>
